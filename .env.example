# Panel runtime config. Copy to .env and fill in.

# mindwtr-cloud base URL. On the Pi this is the local container.
MINDWTR_URL=http://127.0.0.1:8787
# Bearer token — same value as MINDWTR_CLOUD_AUTH_TOKENS on the server.
MINDWTR_TOKEN=

# What the panel shows: next | inbox | waiting | someday | focus
PANEL_VIEW=next
# Seconds between polls. E-ink refresh is ~1.5s, so don't go below ~60.
PANEL_POLL_SECONDS=300

# Backends: epaper | png  (png writes a file, for working without hardware)
PANEL_DISPLAY=png
# Backends: evdev | none
PANEL_TOUCH=none
# Where the png backend writes.
PANEL_PNG_PATH=local/panel.png
# evdev device for the GT911, once the overlay is loaded.
PANEL_TOUCH_DEVICE=/dev/input/event0
