# Panel runtime config. Copy to .env and fill in.

# mindwtr-cloud base URL. On the Pi this is the local container.
MINDWTR_URL=http://127.0.0.1:8787
# Bearer token — same value as MINDWTR_CLOUD_AUTH_TOKENS on the server.
MINDWTR_TOKEN=

# What the panel shows. `focus` leads with today's starred tasks and fills the
# remaining rows from next actions.
# focus | next | inbox | waiting | someday
PANEL_VIEW=focus
# Seconds between full refreshes regardless of whether anything changed — a
# fallback, not the main mechanism. E-ink full refresh is ~1.5s, don't go
# below ~60.
PANEL_POLL_SECONDS=300
# Seconds between cheap HEAD /v1/data checks (one filesystem stat() on the
# server, no JSON). A change here triggers an immediate real fetch, so this
# — not PANEL_POLL_SECONDS — is what makes completing a task on the phone
# show up on the wall quickly.
PANEL_CHECK_SECONDS=5

# Backends: epaper | png  (png writes a file, for working without hardware)
PANEL_DISPLAY=png
# Backends: evdev | none
PANEL_TOUCH=none
# Where the png backend writes.
PANEL_PNG_PATH=local/panel.png
# evdev device for the GT911, once the overlay is loaded.
PANEL_TOUCH_DEVICE=/dev/input/event0
