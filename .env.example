# Panel runtime config. Copy to .env and fill in.

# mindwtr-cloud base URL. On the Pi this is the local container.
MINDWTR_URL=http://127.0.0.1:8787
# Bearer token — same value as MINDWTR_CLOUD_AUTH_TOKENS on the server.
MINDWTR_TOKEN=

# The view tab the panel starts on (the header's tabs switch between them).
# `focus` leads with today's starred tasks and fills the remaining rows from
# next actions.
# focus | inbox | waiting | someday
PANEL_VIEW=focus
# Seconds between re-fetches regardless of whether anything changed — a
# fallback, not the main mechanism (the check below is).
PANEL_POLL_SECONDS=300
# Seconds between cheap HEAD /v1/data checks (one filesystem stat() on the
# server, no JSON). A change here triggers an immediate real fetch, so this
# — not PANEL_POLL_SECONDS — is what makes completing a task on the phone
# show up on the wall quickly.
PANEL_CHECK_SECONDS=5

# Backends: epaper | png  (png writes a file, for working without hardware)
PANEL_DISPLAY=png
# Backends: evdev | none
PANEL_TOUCH=none
# Waveform for the e-paper's occasional ghosting-clearing full refresh:
# fast (the driver's init_fast — shorter flash, with every 4th one normal to
# clear what fast leaves behind) | normal (always the default init).
# Every other update is a partial refresh either way.
PANEL_FULL_REFRESH=fast
# How far the panel is turned clockwise from its native landscape, as mounted:
# 0 | 90 | 180 | 270. 90 and 270 give the 480x800 portrait layout (more rows),
# the default and the main one (270, when this is left unset).
# Applies to the e-paper display and touch; the png backend stays upright.
# This is only the starting orientation: the header's rotate button toggles
# 0 <-> 270 (the UI turned 90 degrees clockwise) and remembers the choice in
# PANEL_STATE_PATH, which then wins over this. 90 and 180 can only be set here
# (delete the saved file after changing).
# TODO(oli): confirm 270 is the way the panel ends up mounted; 90 is the other.
PANEL_ROTATION=270
# Where the rotate button remembers its choice (relative to the repo root).
PANEL_STATE_PATH=local/state.json
# Where the png backend writes.
PANEL_PNG_PATH=local/panel.png
# The screen lock (padlock in the header): a clock face that hides the tasks.
# Digits only — the keypad has nothing else. Empty means a tap unlocks it: it
# still hides the list, it just doesn't keep anyone out.
PANEL_PASSCODE=
# Lock-screen background pictures (relative to the repo root). Any image file
# dropped in is used, one per day in name order; cropped to fill and dithered
# to 1-bit. Empty or missing gives a plain clock.
PANEL_LOCK_IMAGES=local/lockscreen
# evdev device for the touch chip, once its overlay is loaded. Use the by-path
# link: eventN numbers shift when the overlay loads at boot rather than by hand.
PANEL_TOUCH_DEVICE=/dev/input/by-path/platform-ffffffff00000001.i2c-event
