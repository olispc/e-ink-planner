# Server-side config for deploy/compose.yaml. Copy to deploy/.env.

# 20-512 chars. Every device syncing together uses this same value; a different
# token gets a different, isolated dataset on the same server.
#   openssl rand -hex 32
MINDWTR_CLOUD_AUTH_TOKENS=

# Only matters if you later serve a browser client. Native apps ignore it.
MINDWTR_CLOUD_CORS_ORIGIN=http://localhost:5173
